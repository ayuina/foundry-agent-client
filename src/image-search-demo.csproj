    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.26.0" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ImageSearchDemo.Tests\**" />
    <Content Remove="grounding-samples\**" />
    <Content Remove="ImageSearchDemo.Tests\**" />
    <None Remove="grounding-samples\**" />
    <None Remove="ImageSearchDemo.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImageSearchDemo.Tests" />
  </ItemGroup>

</Project>
